  },
  "dependencies": {
    "@evermora/types": "*",
    "@evermora/utils": "*",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@evermora/config": "*",
    "eslint": "^9.39.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
