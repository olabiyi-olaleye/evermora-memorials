{
  "name": "@evermora/domain",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Framework-independent Evermora business/domain layer. No React, no Next.js, no browser APIs.",
  "exports": {
    "./package.json": "./package.json",
    ".": "./src/index.ts"
  },
  "scripts": {
