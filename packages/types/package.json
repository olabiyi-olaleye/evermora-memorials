{
  "name": "@evermora/types",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Shared Evermora TypeScript types and contracts: domain enums, roles, permissions, and event names.",
  "exports": {
    "./package.json": "./package.json",
    ".": "./src/index.ts"
  },
