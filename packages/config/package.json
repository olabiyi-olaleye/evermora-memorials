{
  "name": "@evermora/config",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Shared Evermora configuration: TypeScript, ESLint, Prettier, and Zod environment-validation foundations.",
  "exports": {
    "./package.json": "./package.json",
    ".": "./src/index.ts",
    "./env": "./src/env/index.ts",
    "./eslint/base": "./eslint/base.mjs",
    "./eslint/next": "./eslint/next.mjs",
    "./eslint/node-library": "./eslint/node-library.mjs",
    "./eslint/react-library": "./eslint/react-library.mjs",
    "./prettier": "./prettier/index.mjs",
    "./typescript/base.json": "./typescript/base.json",
    "./typescript/nextjs.json": "./typescript/nextjs.json",
    "./typescript/react-library.json": "./typescript/react-library.json",
    "./typescript/node-library.json": "./typescript/node-library.json"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rimraf --glob .turbo coverage *.tsbuildinfo"
  },
  "dependencies": {
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.3.8",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.11"
  }
}
