# ===========================================================================
# Evermora — Environment Variable Reference (.env.example)
# ===========================================================================
# Copy this file to `.env.local` inside the app you are running (or to a root
# `.env` for shared local tooling) and fill in real values locally.
#
# RULES
#   - This file contains PLACEHOLDERS ONLY. Never commit real secrets.
#   - Variables prefixed NEXT_PUBLIC_ are exposed to the browser. Never put a
#     secret behind a NEXT_PUBLIC_ prefix.
#   - SUPABASE_SERVICE_ROLE_KEY and DATABASE_URL are SERVER-ONLY. They must
#     never reach client bundles.
#   - Real values are configured per environment (Development / Preview /
#     Production) in Vercel and in your local untracked env files.
# ===========================================================================

# --- Runtime -------------------------------------------------------------
# One of: development | staging | production
APP_ENV=development

# --- Public application URLs (client-safe) ------------------------------
# Public marketing site + public memorial experience (apps/web)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Authenticated family portal (apps/family-portal)
NEXT_PUBLIC_FAMILY_URL=http://localhost:3001
# Internal platform admin (apps/platform-admin)
NEXT_PUBLIC_ADMIN_URL=http://localhost:3002

# --- Supabase (client-safe) -------------------------------------------
# LOCAL DEV: run `supabase start` then `supabase status` to print the values
# below. The Evermora local stack is offset from the Supabase defaults:
#   API   http://127.0.0.1:54421     Studio http://127.0.0.1:54423
#   DB    postgresql://postgres:postgres@127.0.0.1:54422/postgres
# The local anon/service keys are shared, well-known dev defaults — fine locally,
# never for a real project.
#
# Project URL, e.g. https://YOUR-PROJECT-ref.supabase.co  (local: http://127.0.0.1:54421)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Anon / publishable key — safe for the browser, still governed by RLS
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# --- Supabase (SERVER ONLY — never expose to the browser) --------------
# Service role / secret key — BYPASSES RLS. Server contexts only. Never NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# Direct Postgres connection string for Drizzle + `db:pull` (server only).
# e.g. postgresql://postgres:PASSWORD@db.your-project-ref.supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54422/postgres

# --- Email provider (SERVER ONLY — provider chosen at implementation time) ---
# Adapter-based; see docs/architecture/notification-architecture.md
EMAIL_PROVIDER_API_KEY=your-email-provider-api-key

# --- Maps / geocoding (used for funeral event locations) --------------
MAP_PROVIDER_KEY=your-map-provider-key

# --- Payments (SERVER ONLY — introduced later) ------------------------
PAYMENT_PROVIDER_SECRET=your-payment-provider-secret
